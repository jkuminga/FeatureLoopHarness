{
  "name": "harness",
  "version": "1.0.0",
  "description": "Codex workflow harness template",
  "private": true,
  "license": "ISC",
  "type": "commonjs",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "python3 -m unittest tests/hooks/test_user_prompt_submit.py tests/hooks/test_pre_commit.py",
    "precommit": "python3 .flh/scripts/pre_commit.py",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
