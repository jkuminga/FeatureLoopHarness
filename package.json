{
  "name": "harness",
  "version": "1.0.0",
  "description": "Codex workflow harness template",
  "private": true,
  "license": "ISC",
  "type": "commonjs",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "python3 -m unittest tests/hooks/test_user_prompt_submit.py",
    "precommit": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.6"
  },
  "lint-staged": {
    ".flh/hooks/user_prompt_submit.py": [
      "bash -c 'python3 -m unittest tests/hooks/test_user_prompt_submit.py'"
    ],
    "tests/hooks/*.py": [
      "bash -c 'python3 -m unittest tests/hooks/test_user_prompt_submit.py'"
    ],
    ".flh/workflow/*.{yml,yaml}": [
      "bash -c 'python3 -m unittest tests/hooks/test_user_prompt_submit.py'"
    ],
    ".codex/hooks/*": [
      "bash -c 'python3 -m unittest tests/hooks/test_user_prompt_submit.py'"
    ],
    ".codex/hooks.json": [
      "bash -c 'python3 -m unittest tests/hooks/test_user_prompt_submit.py'"
    ],
    "AGENTS.md": [
      "bash -c 'python3 -m unittest tests/hooks/test_user_prompt_submit.py'"
    ],
    "README.md": [
      "bash -c 'python3 -m unittest tests/hooks/test_user_prompt_submit.py'"
    ]
  }
}
